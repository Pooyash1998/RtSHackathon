# Frontend environment template
# Copy this file to frontend/.env for local development.
# Vite exposes VITE_* values to browser users, so never put backend
# secrets, OpenAI keys, Black Forest Labs keys, or Supabase service-role
# keys in this file.

# Local development only. Production deployments must provide their own API URL.
VITE_API_URL=http://127.0.0.1:8000
